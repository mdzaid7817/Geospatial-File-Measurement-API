<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Accuracy test</name>

    <Placemark><name>0 Buenos Aires (southern hemisphere)</name>
